# ---------------------------------------------------------------------------
# LipSync Studio — copy to .env and fill in. Every value below is a working
# default for local development; only the secrets need changing for production.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- data stores -----------------------------------------------------------
DATABASE_URL=postgresql://lipsync:lipsync@localhost:5432/lipsync?schema=public
# Used only by migrations. Behind a connection pooler (Supabase, PgBouncer)
# this must be the direct port; with plain Postgres it is the same URL.
DIRECT_DATABASE_URL=postgresql://lipsync:lipsync@localhost:5432/lipsync?schema=public
REDIS_URL=redis://localhost:6379

# --- auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- python inference service ----------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=dev-ai-token

# --- object storage --------------------------------------------------------
# local | s3 | r2 | gcs | azure
STORAGE_DRIVER=local
STORAGE_BUCKET=lipsync-media
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL=http://localhost:4000/media
STORAGE_LOCAL_PATH=./storage
# STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# --- payments --------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
# AIRTEL_CLIENT_ID=
# AIRTEL_SECRET=
# MTN_SUBSCRIPTION_KEY=
# MTN_API_USER=

# --- email -----------------------------------------------------------------
# Omit SMTP_URL to log mail to stdout instead of sending it.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM="LipSync Studio <no-reply@lipsyncstudio.app>"

# --- oauth (optional) ------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# --- operations ------------------------------------------------------------
DEFAULT_RETENTION_DAYS=30
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
ENABLE_QUEUE=true
ENABLE_VIRUS_SCAN=false
LOG_LEVEL=info

# --- frontend (apps/web) ---------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
