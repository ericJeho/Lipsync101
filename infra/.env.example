# Copy to infra/.env before running docker compose.
# Generate the secrets with: openssl rand -base64 48

POSTGRES_PASSWORD=change-me
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
AI_SERVICE_TOKEN=change-me-shared-between-api-and-ai

API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

STORAGE_DRIVER=local
WHISPER_MODEL=small
LOG_LEVEL=info
