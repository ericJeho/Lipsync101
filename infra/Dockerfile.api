# syntax=docker/dockerfile:1
#
# API and render worker. Both run from this image; the worker just overrides
# the command, which keeps them on identical code and dependencies.

# ---------------------------------------------------------------------------
# Dependencies — cached independently of source so a code change does not
# re-run npm install.
# ---------------------------------------------------------------------------
FROM node:22-alpine AS deps

WORKDIR /app

# argon2 and other native modules need a toolchain to build.
RUN apk add --no-cache python3 make g++ libc6-compat

COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/

# --ignore-scripts would skip the Prisma postinstall, so it stays on.
RUN npm ci --workspace @lipsync/api --workspace @lipsync/shared --include-workspace-root

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
FROM node:22-alpine AS build

WORKDIR /app
RUN apk add --no-cache libc6-compat

COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

RUN npm run build --workspace @lipsync/shared \
  && npx prisma generate --schema apps/api/prisma/schema.prisma \
  && npm run build --workspace @lipsync/api

# Drop dev dependencies from the tree that gets copied into the runtime image.
RUN npm prune --omit=dev --workspace @lipsync/api --workspace @lipsync/shared --include-workspace-root

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
FROM node:22-alpine AS runtime

WORKDIR /app

# ffmpeg for the odd server-side probe; tini so signals reach node and the
# graceful shutdown handler actually runs on SIGTERM.
RUN apk add --no-cache ffmpeg tini libc6-compat \
  && addgroup -g 1001 -S lipsync \
  && adduser -u 1001 -S lipsync -G lipsync

ENV NODE_ENV=production

COPY --from=build --chown=lipsync:lipsync /app/node_modules ./node_modules
COPY --from=build --chown=lipsync:lipsync /app/packages/shared/dist ./packages/shared/dist
COPY --from=build --chown=lipsync:lipsync /app/packages/shared/package.json ./packages/shared/
COPY --from=build --chown=lipsync:lipsync /app/apps/api/dist ./apps/api/dist
COPY --from=build --chown=lipsync:lipsync /app/apps/api/package.json ./apps/api/
COPY --from=build --chown=lipsync:lipsync /app/apps/api/prisma ./apps/api/prisma

RUN mkdir -p /data/storage && chown -R lipsync:lipsync /data

USER lipsync
WORKDIR /app/apps/api

EXPOSE 4000

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/server.js"]
